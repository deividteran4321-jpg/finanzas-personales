# Copia este archivo a ".streamlit/secrets.toml" (que ya está en .gitignore,
# nunca lo subas al repo) y completa tus propios valores.
#
# En Streamlit Community Cloud, estos mismos valores se configuran en
# "Settings -> Secrets" del panel de la app, NO en un archivo del repo.

# Cadena de conexión a tu proyecto de Supabase (Postgres).
# En Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL = "postgresql://postgres:TU_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# Usuario y contraseña del admin que se crea automáticamente la PRIMERA vez
# que la app arranca (solo se usan si la tabla "usuarios" está vacía).
# Después de tu primer login, cambia la contraseña desde la página Admin
# y estos valores ya no se vuelven a usar.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "cambia-esto-por-una-contraseña-fuerte"

# Clave secreta usada para firmar la cookie de sesión ("recordarme").
# Genera una propia (cualquier cadena larga y aleatoria) y no la compartas.
AUTH_COOKIE_KEY = "genera-una-clave-larga-y-aleatoria-aqui"
